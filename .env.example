# ── Desenvolvimento local (Postgres no Docker: `npm run db:up`) ──
DATABASE_URL=postgresql://fila:fila@localhost:5432/fila
ADMIN_PASSWORD=admin-local
SESSION_SECRET=troque-por-um-texto-aleatorio-longo
# Notificações: opcionais no local. Sem as chaves, a fila funciona e só não envia push.
# Gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com

# ── Produção (configurado na Vercel) ──
# DATABASE_URL = URL do Neon com "-pooler"; o app troca de driver sozinho pelo host.
